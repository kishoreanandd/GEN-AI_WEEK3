    {
      "parameters": {
        "jsCode": "// Get all rows coming from the Edit Fields node.\nconst items = $input.all();\n\n// Combine every row into one readable email body.\nconst rows = items.map(item => {\n  const data = item.json;\n  return `- Name: ${data.Name || 'N/A'}\n  Course: ${data.Course || 'N/A'}\n  Status: ${data.Status || 'N/A'}`;\n});\n\n// Create one email subject and one combined body.\nreturn [{\n  json: {\n    subject: 'Data Summary from Google Sheet',\n    body: `Hi,\n\nHere is the latest data from the sheet:\n\n${rows.join('\\n\\n')}\n\nRegards,\nYour Automation Bot`\n  }\n}];"
      },
