    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw =\n  $json.text ??\n  $json.output ??\n  $json.response ??\n  '';\n\nlet cleaned = String(raw).trim();\n\ncleaned = cleaned\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\ntry {\n  const data = JSON.parse(cleaned);\n\n  return {\n    json: data\n  };\n\n} catch (error) {\n\n  return {\n    json: {\n      parse_error: true,\n      raw_ai_response: raw,\n      error: String(error)\n    }\n  };\n}"
      },
